generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
  PENDING
}

model Employee {
  id        String   @id @default(uuid())
  name      String
  role      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("funcionarios")
}

model Property {
  id          String         @id @default(uuid())
  title       String
  description String?
  type        PropertyType
  address     String
  area        Float
  bedrooms    Int?
  bathrooms   Int?
  price       Decimal        @db.Decimal(10, 2)
  status      PropertyStatus @default(AVAILABLE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("imoveis")
}
